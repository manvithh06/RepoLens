# Application
APP_NAME=RepoLens
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Optional: raises GitHub API rate limits (used from Phase 3)
GITHUB_TOKEN=

# Hugging Face Inference, used for the guided tour and repository chat (Phases 6 and 7).
# Create a token with the "Make calls to Inference Providers" permission at
# https://huggingface.co/settings/tokens
HF_TOKEN=
# Any chat model served by Hugging Face Inference Providers. Leave empty for the default.
HF_MODEL=
