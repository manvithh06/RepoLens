# Application
APP_NAME=RepoLens
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Optional: raises GitHub API rate limits (used from Phase 3)
GITHUB_TOKEN=

# Language model for the guided tour and repository chat. Leave the key empty to turn
# the AI features off; the rest of the analysis works without them.
#
# Any OpenAI-compatible endpoint. Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=
# API key for LLM_BASE_URL. GROQ_API_KEY is accepted as another name for it.
# Groq keys: https://console.groq.com/keys
LLM_API_KEY=
# Model name. Optional for Groq (default: openai/gpt-oss-120b); required for other endpoints.
# HF_MODEL is accepted as another name for it.
LLM_MODEL=

# Fallback when LLM_BASE_URL is empty: Hugging Face Inference Providers.
# Token with the "Make calls to Inference Providers" permission:
# https://huggingface.co/settings/tokens
HF_TOKEN=
